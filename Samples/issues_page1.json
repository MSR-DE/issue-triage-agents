      "following_url": "https://api.github.com/users/zanieb/following{/other_user}",
      "gists_url": "https://api.github.com/users/zanieb/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/zanieb/starred{/owner}{/repo}",
