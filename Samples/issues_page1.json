    "title": "Surface PEP 508 parse errors instead of falling back to a build",
    "user": {
      "login": "HSP18SCM23P",
      "id": 38229980,
      "node_id": "MDQ6VXNlcjM4MjI5OTgw",
      "avatar_url": "https://avatars.githubusercontent.com/u/38229980?v=4",
